NODE_ENV=development
PORT=4000

# SQLite para dev; troque para postgresql://... em produção
DATABASE_URL="file:./dev.db"

# Segredos
JWT_ACCESS_SECRET="troque-por-string-aleatoria-longa"
JWT_REFRESH_SECRET="outro-segredo-aleatorio"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# CORS
FRONTEND_ORIGIN="http://localhost:5173"

# VAPID (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@correio.local"

# Regras de negócio
DELIVERY_MIN_DAYS=0
DELIVERY_MAX_DAYS=3
DELIVERY_DEV_MODE=false
DELIVERY_DEV_MIN_SECONDS=10
DELIVERY_DEV_MAX_SECONDS=60

# Moeda fictícia
CURRENCY_NAME="Moedas Postais"
CURRENCY_SYMBOL="₥"
INITIAL_BALANCE=500
STAMP_PRICE_DEFAULT=50