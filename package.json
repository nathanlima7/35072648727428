{
  "name": "correio-server",
  "version": "1.0.0",
  "type": "module",
    "scripts": {
    "dev": "nodemon server.js",
    "start": "npx prisma generate --schema prisma-schema.prisma && node server.js",
    "postinstall": "node_modules/.bin/prisma generate --schema prisma-schema.prisma",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "node seed.js",
    "seed:seasonal": "node seed-seasonal.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}
